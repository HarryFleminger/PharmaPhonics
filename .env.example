# Server-side Google Cloud Text-to-Speech API Key (never exposed to browser)
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here

# Server-side Google Gemini API Key (never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Server-side PostHog Project API Key & Ingest Host for anonymous usage analytics
POSTHOG_API_KEY=your_posthog_project_api_key_here
POSTHOG_HOST=https://eu.i.posthog.com
